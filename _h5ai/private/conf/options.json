/* h5ai v0.30.0 - https://larsjung.de/h5ai/ */
{
    /*
    パスワードのハッシュ値。

    情報ページのパスワードのSHA512ハッシュ、プリセットのパスワードは空文字列です。
    オンラインハッシュジェネレータ： http://md5hashing.net/hashing/sha512
    */
    "passhash": "569389c9da24aa6ac42ac823593984d1fe4c68eb1bf44e5862d00fcd7129d1d9ad7a5d7dd1784277cba3a2671596d99c2d54187f2bf3a24633959d4bfa8fabbf",



    /*
    リソース

    全ページにスクリプトとスタイルタグを追加しました。パスが
    http://", "https://", "/" で始まらないパスは、"_h5ai/public/ext/" からの相対パスとして検索されます。
    "_h5ai/public/ext/" からの相対パスで検索されます（存在チェックなし）。

    - scripts: 文字列の配列
    - スタイル: 文字列の配列
    */
    "resources": {
        "scripts": [],
        "styles": [
            "//fonts.googleapis.com/css?family=Ubuntu:300,400,700%7CUbuntu+Mono:400,700"
        ]
    },



    /*
    一般的な表示オプションです。

    - binaryPrefix: boolean, trueに設定すると、ファイルサイズをフォーマットする際に1024B=1KiBを使用します (http://en.wikipedia.org/wiki/Binary_prefix 参照)
    - disableSidebar: boolean, サイドバーとトグルボタンを非表示にする。
    - fallbackMode: boolean、フォールバックモードを提供します。
    - fastBrowsing: boolean, History APIが利用可能な場合、それを使用する(ページ全体を再読み込みする必要がない)
    - fonts: 文字列の配列、通常のコンテキストで使用するフォント。
    - fontsMono: 文字列の配列、等幅フォントで使用するフォント。
    - hidden: 文字列の配列、これらの正規表現にマッチする項目をリストアップしない
    - hideFolders: ブーリアン、メインビューですべてのフォルダーを隠す。
    - hideIf403: boolean, サーバーから読み取れないファイルやフォルダーを隠す。
    - hideParentFolder: boolean, メインビューで親フォルダのリンクを隠す。
    - maxIconSize: 数値、メインビューでのアイコンの最大サイズ
    - modes: 文字列の配列、 ["details", "grid", "icons"] のサブセット。
        最初の値は、デフォルトのビューモードを表します。もし、1つの値
        を指定すると、ビューモードは固定され、選択ボタンは隠されます。
        ユーザーが選択した表示モードは、モダンブラウザではローカルに保存されます。
        に保存され、永続化されます。
    - modeToggle: boolean, ツールバーにビューモードのトグルを表示するか、"next" を表示するかを指定します。
    - setParentFolderLabels: boolean, 親フォルダラベルを実際のフォルダ名に設定します。
    - sizes: 数値の配列。
        最初の値は、デフォルトのビューサイズを表します。1 つの値
        を指定すると、ビューサイズは固定され、セレクタボタンは非表示になります。
        ユーザーが選択したビューサイズは、モダンブラウザではローカルに保存されます。
        に保存され、永続化されます。
    - theme: 文字列、"_h5ai/public/images/themes" にあるフォルダの名前、デフォルトは "default" です。
    - unmanaged: 文字列の配列、これらのファイルのいずれかを含むフォルダを管理しない。
    - unmanagedInNewWindow: boolean、管理されていないリンクを新しいウィンドウ/タブで開きます。
    */
    "view": {
        "binaryPrefix": true,
        "disableSidebar": false,
        "fallbackMode": false,
        "fastBrowsing": true,
        "fonts": ["Ubuntu", "Roboto", "Helvetica", "Arial", "sans-serif"],
        "fontsMono": ["Ubuntu Mono", "Monaco", "Lucida Sans Typewriter", "monospace"],
        "hidden": ["^\\.", "^_h5ai"],
        "hideFolders": false,
        "hideIf403": true,
        "hideParentFolder": true,
        "maxIconSize": 40,
        "modes": ["details", "grid", "icons"],
        "modeToggle": false,
        "setParentFolderLabels": true,
        "sizes": [20, 40, 60, 80, 100, 140, 180, 220, 260, 300],
        "theme": "comity",
        "unmanaged": ["index.html", "index.htm", "index.php"],
        "unmanagedInNewWindow": false
    },



    /*** 拡張機能(アルファベット順) ***/

    /*
    現在のフォルダの内容を監視し、更新する。

    - interval: 数値、更新間隔（ミリ秒単位、最低でも1000
    */
    "autorefresh": {
        "enabled": false,
        "interval": 5000
    },

    /*
    クリック可能なパンくずを表示する。
    */
    "crumb": {
        "enabled": true
    },

    /*
    カスタマイズされたヘッダー ファイルとフッター ファイルを許可します。
    最初に、現在のディレクトリにあるファイル「_h5ai.header.html」と「_h5ai.footer.html」をチェックします。
    成功しなかった場合、ファイル「_h5ai.headers.html」および「_h5ai.footers.html」の
    すべての親ディレクトリ (現在のディレクトリから始まる) をチェックします。
    異なるファイル名に注意してください: "header" (現在のみ) - "headers" (現在およびサブディレクトリ)!
    ファイルのコンテンツは、メイン コンテンツの上/下の <div/> タグ内に配置されます。
    ファイルの拡張子が「.html」ではなく「.md」の場合、そのコンテンツはマークダウンとして解釈されます。

    - stopSearchingAtRoot: ブール値、Web ルート ディレクトリまでヘッダー ファイルとフッター ファイルのみを検索します。 
        「false」の場合、Web ルートの上であっても、ディレクトリ構造全体でヘッダー/フッターを検索します
    */
    "custom": {
        "enabled": true,
        "stopSearchingAtRoot": true
    },

    /*
    選択されたエントリーのパッケージダウンロードを有効にします。
    ファイルを選択するには、"select" 拡張モジュールを有効にする必要があります。

    - type: 文字列、"php-tar"、"shell-tar"、または "shell-zip"
    - packageName: 文字列、ダウンロードパッケージのベースネーム、現在のファイル名またはフォルダ名には null を指定します。
    - alwaysVisible: boolean、常にダウンロードボタンを表示します（デフォルトは現在のフォルダをダウンロードします）。
    */
    "download": {
        "enabled": true,
        "type": "php-tar",
        "packageName": null,
        "alwaysVisible": true
    },

    /*
    現在のフォルダーにある表示中のファイルやフォルダーをフィルタリングできるようにする。
    部分文字列をチェックします。

    advanced を有効にすると、文字の正しい順序でエントリーをチェックします。
    例えば、"ab" は "ab", "axb", "xaxbx" と一致しますが、"ba" とは一致しません。スペースで区切られた
    のシーケンスはORされます。検索はJavaScriptの正規表現として扱われます。
    re:" を前につけると、JavaScript の正規表現として扱われます。

    - advanced: boolean, 高度なパターン解析を行うかどうか。
    - debounceTime: 数値、デバウンス待ち時間(ミリ秒)
    - ignorecase: ブーリアン、大文字小文字を区別しない
    */
    "filter": {
        "enabled": false,
        "advanced": true,
        "debounceTime": 100,
        "ignorecase": true
    },

    /*
    フォルダーのサイズを計算します。
    この操作は本当に遅いです。計算されたサイズは、両者で若干異なります。
    php "はファイルサイズを加算するだけですが、"shell-du "は実際のフォルダファイルのサイズも加算するので
    は実際のフォルダーファイルのサイズも加算されるからです。

    - type: string, "php" (sloooow) or "shell-du" (sloow)
    */
    "foldersize": {
        "enabled": true,
        "type": "shell-du"
    },

    /*
    Google Universial Analyticsの非同期トラッキングコードを追加します。
    参照: https://developers.google.com/analytics/devguides/collection/analyticsjs/

    - id: 文字列、アカウントID
    */
    "google-analytics-ua": {
        "enabled": false,
        "id": "UA-000000-0"
    },

    /*
    一般的な情報サイドバーを有効にする。

    - show: boolean, 初回使用時にのみ表示する。
    - qrcode: boolean, QR-Codeを表示する。
    - qrColor: 文字列, QR-Codeの塗りつぶし色
    */
    "info": {
        "enabled": true,
        "show": true,
        "qrcode": true,
        "qrFill": "#999",
        "qrBack": "#fff"
    },

    /*
    ローカライゼーション、例えば "en", "de" など。- 可能な値については、"_h5ai/conf/l10n" フォルダーを参照してください。
    を参照してください。あなたのニーズに合わせて調整してください。langが見つからない場合
    は、デフォルトで "en "になります。

    - lang: 文字列、デフォルトの言語
    - useBroserLang: boolean、ブラウザの言語を使用しようとする。
    */
    "l10n": {
        "enabled": true,
        "lang": "ja",
        "useBrowserLang": true
    },

    /*
    Piwikトラッカーのjavascriptコードを追加します。

    - baseURL: 文字列、プロトコルは含めない、例："mydomain.tld/piwik"
    - idSite: 数字
    */
    "piwik-analytics": {
        "enabled": false,
        "baseURL": "some/url",
        "idSite": 1
    },

    /*
    クリックすると音声プレビューを再生します。

    - autoplay: 準備ができ次第、再生を開始する。
    - types: 文字列の配列
    */
    "preview-aud": {
        "enabled": true,
        "autoplay": true,
        "types": ["aud"]
    },

    /*
    クリック時に画像プレビューを表示する。

    - types: 文字列の配列
    - size: 数値、サンプルサイズ、オリジナルサイズの場合は false。
    */
    "preview-img": {
        "enabled": true,
        "size": false,
        "types": ["img", "img-bmp", "img-gif", "img-ico", "img-jpg", "img-png", "img-raw", "img-svg"]
    },

    /*
    クリックするとテキストファイルのプレビューを表示します。

    利用可能なスタイルは以下の通りです。
        0: フローティングテキスト
        1: 固定幅テキスト
        2: マークダウン
        3: シンタックスハイライト

    - styles: dict string to int, マップタイプからスタイルへ
    */
    "preview-txt": {
        "enabled": true,
        "styles": {
            "txt": 1,
            "txt-authors": 1,
            "txt-c": 3,
            "txt-cpp": 3,
            "txt-css": 3,
            "txt-diff": 1,
            "txt-go": 3,
            "txt-h": 3,
            "txt-hpp": 3,
            "txt-install": 1,
            "txt-js": 3,
            "txt-json": 3,
            "txt-less": 3,
            "txt-license": 1,
            "txt-log": 1,
            "txt-makefile": 1,
            "txt-md": 2,
            "txt-py": 3,
            "txt-rb": 3,
            "txt-readme": 1,
            "txt-rtf": 1,
            "txt-rust": 3,
            "txt-script": 3,
            "txt-xml": 1
        }
    },

    /*
    クリックすると動画のプレビューを再生します。

    - autoplay: 準備ができ次第、再生を開始します。
    - types: 文字列の配列
    */
    "preview-vid": {
        "enabled": true,
        "autoplay": true,
        "types": ["vid-avi", "vid-flv", "vid-mkv", "vid-mov", "vid-mp4", "vid-mpg", "vid-webm"]
    },

    /*
    現在のフォルダー内およびそれ以下のファイルやフォルダーを検索できるようにします。
    部分文字列をチェックします。

    advanced を有効にすると、文字列の順序が正しいかどうかをチェックします。
    例えば、"ab" は "ab", "axb", "xaxbx" と一致しますが、"ba" とは一致しません。スペースで区切られた
    のシーケンスはORされます。検索はJavaScriptの正規表現として扱われます。
    re:" を前につけると、JavaScript の正規表現として扱われます。

    - advanced: boolean, 高度なパターン解析を行うかどうか。
    - debounceTime: 数値、デバウンス待ち時間(ミリ秒)
    - ignorecase: ブーリアン、大文字小文字を区別しない
    */
    "search": {
        "enabled": true,
        "advanced": true,
        "debounceTime": 300,
        "ignorecase": true
    },

    /*
    エントリーを選択できるようにする。
    現時点では、パッケージダウンロードにのみ必要です。

    - clickndrag: boolean, マウスの第一ボタン＋ドラッグで選択できるようにする。
    - checkboxes: boolean, マウスオーバー時にチェックボックスを表示する。
    */
    "select": {
        "enabled": true,
        "clickndrag": true,
        "checkboxes": true
    },

    /*
    デフォルトのソート順。
    "column" と "reverse" はローカルに保存される。

    - column: 数字。"Name "は0、"Date "は1、"Size "は2。
    - reverse: boolean, 昇順の場合はfalse、降順の場合はtrue。
    - ignorecase: boolean, 大文字小文字を比較する。
    - natural: boolean, 自然なソート順を使用する。
    - folders: 数字、フォルダを配置する場所、0なら "top"、1なら "in place"、2なら "bottom"
    */
    "sort": {
        "enabled": true,
        "column": 0,
        "reverse": false,
        "ignorecase": true,
        "natural": true,
        "folders": 0
    },

    /*
    画像ファイルのサムネイルを表示します。ウェブサーバーから"/h5ai/public/cache "フォルダを書き込み可能にする必要があります。
    が書き込み可能である必要があります。

    - img: 文字列の配列
    - mov: 文字列の配列
    - doc: 文字列の配列
    - delay: 数値、"dom-ready "の後、サム・リクエスト開始までのミリ秒単位での遅延時間
    - size: 数値、生成されるサムネイルのピクセル単位の大きさ。
    - exif: boolean、可能なら同梱の EXIF サムネイルを使用する。
    - chunksize: int, リクエストごとのサムネイルの数。
    */
    "thumbnails": {
        "enabled": true,
        "img": ["img-bmp", "img-gif", "img-ico", "img-jpg", "img-png"],
        "mov": ["vid-avi", "vid-flv", "vid-mkv", "vid-mov", "vid-mp4", "vid-mpg", "vid-webm"],
        "doc": ["x-pdf", "x-ps"],
        "delay": 1,
        "size": 240,
        "exif": true,
        "chunksize": 20
    },

    /*
    ウィンドウのタイトルを現在のパンくずで置き換えます。
    */
    "title": {
        "enabled": true
    },

    /*
    フォルダツリーを表示します。
    パフォーマンスに大きな影響を与える可能性があることに注意してください。

    - show: boolean, 初回使用時に表示されます。
    - maxSubfolders: 数字、ツリー内に表示するサブフォルダーの最大数
    - naturalSort: ブール値、フォルダーを自然な順序でソートします。
    - ignorecase: ブーリアン、大文字と小文字を区別せずにソートします。
    */
    "tree": {
        "enabled": true,
        "show": false,
        "maxSubfolders": 50,
        "naturalSort": true,
        "ignorecase": true
    }
}
